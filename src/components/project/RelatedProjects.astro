---
import type { CollectionEntry } from 'astro:content';
import { getRelated } from '@lib/projects';
import ProjectCard from './ProjectCard.astro';

interface Props {
  current: CollectionEntry<'progetti'>;
}
const { current } = Astro.props;
const related = await getRelated(current, 3);
---

{
  related.length > 0 && (
    <section class="related container-editorial" aria-labelledby="related-title">
      <header class="related__head">
        <p class="type-eyebrow related__eyebrow">Continua a esplorare</p>
        <h2 class="type-h2 related__title" id="related-title">Altri progetti</h2>
      </header>
      <div class="related__grid">
        {related.map((p) => (
          <ProjectCard progetto={p} aspect="4/3" />
        ))}
      </div>
    </section>
  )
}

<style>
  .related {
    padding-block: 5rem;
    border-block-start: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .related {
      padding-block: 7rem;
    }
  }

  .related__head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-block-end: 3rem;
  }

  @media (min-width: 768px) {
    .related__head {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: 2rem;
      margin-block-end: 4rem;
    }
  }

  .related__eyebrow {
    color: var(--color-fg-subtle);
  }

  .related__title {
    margin: 0;
  }

  .related__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 640px) {
    .related__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .related__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
