---
import { studio, menuGroups } from '@data/studio';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-editorial site-footer__inner">
    <div class="site-footer__grid">
      <div class="site-footer__col site-footer__col--brand">
        <p class="site-footer__logo">MONTACUTI</p>
        <p class="type-body-sm site-footer__tagline">
          Studio di architettura. Progetti residenziali, commerciali e di
          riqualificazione urbana in Cesena e in Romagna.
        </p>
      </div>

      <div class="site-footer__col">
        <p class="type-eyebrow site-footer__col-label">Studio</p>
        <address class="site-footer__address">
          <p class="type-body-sm">{studio.indirizzo.via}</p>
          <p class="type-body-sm">
            {studio.indirizzo.cap} {studio.indirizzo.citta} ({studio.indirizzo.provincia})
          </p>
          <p class="type-body-sm site-footer__contact">
            <a href={`mailto:${studio.contatti.email}`}>{studio.contatti.email}</a>
          </p>
          <p class="type-body-sm site-footer__contact">
            <a href={`tel:${studio.contatti.telefono.replace(/\s/g, '')}`}>
              T {studio.contatti.telefono}
            </a>
          </p>
          <p class="type-body-sm site-footer__contact">
            <a href={`tel:${studio.contatti.cellulare.replace(/\s/g, '')}`}>
              M {studio.contatti.cellulare}
            </a>
          </p>
        </address>
      </div>

      <div class="site-footer__col">
        <p class="type-eyebrow site-footer__col-label">{menuGroups[0].eyebrow}</p>
        <ul class="site-footer__list">
          {
            menuGroups[0].items.map((item) => (
              <li>
                <a class="site-footer__link" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="site-footer__col">
        <p class="type-eyebrow site-footer__col-label">Naviga</p>
        <ul class="site-footer__list">
          <li><a class="site-footer__link" href="/studio">Lo studio</a></li>
          <li><a class="site-footer__link" href="/contatti">Contatti</a></li>
          <li><a class="site-footer__link" href="/contatti#form">Inizia un progetto</a></li>
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="type-caption">
        © {year} Studio Arnaldo Montacuti — Architetto · P.IVA da definire
      </p>
      <ul class="site-footer__legal">
        <li>
          <a class="site-footer__legal-link" href="/privacy">Privacy</a>
        </li>
        <li>
          <a class="site-footer__legal-link" href="/cookie">Cookie</a>
        </li>
        <li>
          <a
            class="site-footer__legal-link"
            href="https://www.bedr.studio/"
            target="_blank"
            rel="noopener"
            aria-label="Bedr Studio (si apre in una nuova scheda)"
          >Site by Bedr ↗</a>
        </li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-bg-subtle);
    border-block-start: 1px solid var(--color-border);
    color: var(--color-fg);
  }

  .site-footer__inner {
    padding-block: 4rem 2.5rem;
  }

  @media (min-width: 768px) {
    .site-footer__inner {
      padding-block: 6rem 3rem;
    }
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-block-end: 4rem;
    border-block-end: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3rem;
    }
  }

  @media (min-width: 1024px) {
    .site-footer__grid {
      grid-template-columns: 1.4fr repeat(3, minmax(0, 1fr));
      gap: 4rem;
    }
  }

  .site-footer__col--brand {
    max-width: 32ch;
  }

  .site-footer__logo {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    margin-block-end: 1.25rem;
  }

  .site-footer__tagline {
    color: var(--color-fg-muted);
    line-height: 1.55;
  }

  .site-footer__col-label {
    color: var(--color-fg-subtle);
    margin-block-end: 1.25rem;
  }

  .site-footer__address {
    font-style: normal;
  }

  .site-footer__address p {
    line-height: 1.55;
  }

  .site-footer__address p + p {
    margin-block-start: 0.25rem;
  }

  .site-footer__contact {
    margin-block-start: 0.75rem !important;
  }

  .site-footer__contact a {
    text-decoration: none;
    border-block-end: 1px solid var(--color-border);
    transition: border-color var(--duration-fast) var(--ease-default);
  }

  .site-footer__contact a:hover,
  .site-footer__contact a:focus-visible {
    border-block-end-color: var(--color-fg);
  }

  .site-footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .site-footer__link {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--color-fg);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-default);
  }

  .site-footer__link:hover,
  .site-footer__link:focus-visible {
    color: var(--color-accent);
  }

  .site-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block-start: 2rem;
  }

  @media (min-width: 640px) {
    .site-footer__bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .site-footer__legal {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 1.5rem;
  }

  .site-footer__legal-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-default);
  }

  .site-footer__legal-link:hover,
  .site-footer__legal-link:focus-visible {
    color: var(--color-fg);
  }
</style>
