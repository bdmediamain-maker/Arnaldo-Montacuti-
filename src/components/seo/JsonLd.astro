---
/**
 * JsonLd — emette un blocco <script type="application/ld+json">.
 * Stringify-a in modo safe i caratteri `<` per evitare XSS quando il
 * payload contiene HTML user-generated.
 */
interface Props {
  data: Record<string, unknown> | Array<Record<string, unknown>>;
}
const { data } = Astro.props;

const json = JSON.stringify(data).replace(/</g, '\\u003c');
---

<script type="application/ld+json" set:html={json} />
